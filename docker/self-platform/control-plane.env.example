FLEET_PUBLIC_URL=http://192.168.1.100:8001
FLEET_HTTP_PORT=8001
FLEET_STUDIO_IMAGE=deluxebear/supabase-plt-studio:latest
MANAGED_NETWORK_NAME=supabase-plt_default

PLATFORM_POSTGRES_PASSWORD=replace-with-a-random-secret
PLATFORM_OUTBOX_DISPATCHER_PASSWORD=replace-with-another-random-secret
FLEET_CONTROL_POSTGRES_PASSWORD=replace-with-a-different-random-secret
BACKUP_OPERATOR_POSTGRES_PASSWORD=replace-with-a-third-random-secret
PLATFORM_JWT_SECRET=replace-with-at-least-32-random-bytes
PLATFORM_ENCRYPTION_KEY=replace-with-a-random-secret
PG_META_CRYPTO_KEY=replace-with-at-least-32-random-characters

FLEET_CONTROL_VERSION=v0.1.0
FLEET_CONTROL_SERVICE_ASSERTION_KEY=replace-with-a-separate-at-least-32-byte-secret
FLEET_CONTROL_SERVICE_ASSERTION_ISSUER=studio-platform
FLEET_CONTROL_SERVICE_ASSERTION_AUDIENCE=fleet-control
FLEET_CONTROL_HTTP_PORT=8090
FLEET_CONTROL_ENROLLMENT_HTTPS_PORT=8091
FLEET_CONTROL_AGENT_TRUST_DOMAIN=fleet.internal
FLEET_CONTROL_AGENT_CERT_TTL=1h
FLEET_CONTROL_ENROLLMENT_TOKEN_TTL=10m
FLEET_CONTROL_AGENT_CERT_OVERLAP=5m
FLEET_CONTROL_STORE_SYSTEM_IDENTIFIER=fleet-control
FLEET_CONTROL_STORE_DATA_DOMAIN=fleet-control-db-data
FLEET_OUTBOX_WORKER_ID=fleet-outbox-1
FLEET_OUTBOX_LEASE=30s
FLEET_OUTBOX_POLL_INTERVAL=2s

BACKUP_OPERATOR_VERSION=v0.1.1
# Standalone/Embedded Operator deployments may use a separate key. In this
# Fleet Compose file, registered domain APIs use FLEET_CONTROL_SERVICE_ASSERTION_KEY.
BACKUP_OPERATOR_SERVICE_ASSERTION_KEY=replace-with-at-least-32-random-bytes
BACKUP_OPERATOR_SERVICE_ASSERTION_ISSUER=studio-platform
BACKUP_OPERATOR_SERVICE_ASSERTION_AUDIENCE=backup-operator
BACKUP_OPERATOR_HTTP_PORT=8080
BACKUP_OPERATOR_CONTROL_STORE_SYSTEM_IDENTIFIER=fleet-backup-control
BACKUP_OPERATOR_CONTROL_STORE_DATA_DOMAIN=backup-operator-db-data

# Optional compatibility fallback only. Fleet project requests resolve their
# own project-scoped credentials server-side.
MANAGED_SUPABASE_URL=http://kong:8000
MANAGED_ANON_KEY=
MANAGED_SERVICE_ROLE_KEY=
MANAGED_JWT_SECRET=
