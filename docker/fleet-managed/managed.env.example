MANAGED_PROJECT_REF=project-a
MANAGED_CONTAINER_PREFIX=supabase-managed-a
MANAGED_KONG_HTTP_PORT=8200
MANAGED_KONG_HTTPS_PORT=8543
MANAGED_DB_DIRECT_HOST_PORT=55433
MANAGED_POSTGRES_HOST_PORT=55432
MANAGED_POOLER_HOST_PORT=56543
SUPABASE_PUBLIC_URL=http://192.168.1.100:8200
API_EXTERNAL_URL=http://192.168.1.100:8200/auth/v1
SITE_URL=http://192.168.1.100:8200
POOLER_TENANT_ID=project-a

# Generated independently by scripts/init-instance-env.sh for every managed
# stack. Never copy these values between projects or commit populated env files.
POSTGRES_PASSWORD=generate-per-project
JWT_SECRET=generate-per-project
ANON_KEY=generate-per-project
SERVICE_ROLE_KEY=generate-per-project
SECRET_KEY_BASE=generate-per-project
REALTIME_DB_ENC_KEY=generate-per-project
VAULT_ENC_KEY=generate-per-project
LOGFLARE_PUBLIC_ACCESS_TOKEN=generate-per-project
LOGFLARE_PRIVATE_ACCESS_TOKEN=generate-per-project
S3_PROTOCOL_ACCESS_KEY_ID=generate-per-project
S3_PROTOCOL_ACCESS_KEY_SECRET=generate-per-project
FLEET_MANAGEMENT_NETWORK_NAME=fleet-management
PG_META_CRYPTO_KEY=copy-from-control-plane-env
# Local build tag. For releases, use ghcr.io/<owner>/fleet-control:<version>
# (published by .github/workflows/fleet-control-release.yml).
FLEET_AGENT_IMAGE=supabase-fleet-control:simulation
FLEET_FUNCTION_PROJECT_KEY=replace-with-first-24-hex-of-project-ref-sha256
FLEET_FUNCTION_ROOT=./fleet-managed/state/project-a/functions
FLEET_CONFIG_ROOT=./fleet-managed/state/project-a/config

# Filled after Central Studio creates the management target, binding, and
# single-use enrollment token. Keep the populated file mode 0600.
FLEET_AGENT_ENROLLMENT_TOKEN=
FLEET_AGENT_ORGANIZATION_ID=
FLEET_AGENT_TARGET_ID=
FLEET_AGENT_BINDING_ID=
FLEET_AGENT_EXECUTION_TARGET=compose-project-a
FLEET_AGENT_ID=agent-project-a
FLEET_AGENT_NODE_ID=node-project-a
