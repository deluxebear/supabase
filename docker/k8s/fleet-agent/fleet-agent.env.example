# Copy to fleet-agent.env and fill in from the Studio Fleet attach flow.
# deploy.sh turns this into the ConfigMap fleet-agent-identity; the token and
# the enrollment CA go into the Secret fleet-agent-enrollment. Never commit
# fleet-agent.env.

# Fleet image (the Fleet Control image carries fleet-agent and its bootstrap).
FLEET_AGENT_IMAGE=ghcr.io/deluxebear/fleet-control:latest

# Enrollment (single use).
FLEET_AGENT_ENROLLMENT_URL=https://fleet-control.example.com:8091
FLEET_AGENT_ENROLLMENT_TOKEN=
FLEET_AGENT_ENROLLMENT_CA_FILE=./enrollment-ca.crt

# Binding identity, as shown in Studio.
FLEET_AGENT_ORGANIZATION_ID=
FLEET_AGENT_PROJECT_REF=
FLEET_AGENT_TARGET_ID=
FLEET_AGENT_BINDING_ID=
FLEET_AGENT_ID=
FLEET_AGENT_EXECUTION_TARGET=kubernetes-supabase
FLEET_AGENT_NODE_ID=kubernetes-supabase

# Fleet Control mTLS gRPC endpoint.
FLEET_AGENT_CONTROL_ADDRESS=fleet-control.example.com:8092
FLEET_AGENT_SERVER_NAME=fleet-control

# Optional directory of PEM CA files for Supavisor SSL enforcement. Studio
# refers to them by file name.
FLEET_AGENT_DATABASE_TLS_CA_DIR=

# Deployments that may receive sealed secrets. Keep 10-rbac.yaml in step.
FLEET_AGENT_KUBERNETES_SECRET_SERVICES=functions,auth

# Deployments lifecycle actions may restart, roll out, or scale. The database
# StatefulSet is never included. Keep 10-rbac.yaml in step.
FLEET_AGENT_KUBERNETES_LIFECYCLE_SERVICES=auth,rest,realtime,storage,imgproxy,meta,functions,supavisor

# Must equal FLEET_LIFECYCLE_COMPONENT_VERSIONS of the Studio server (single-quoted
# because deploy.sh sources this file); the Agent
# rejects plans built from different component versions.
FLEET_AGENT_LIFECYCLE_COMPONENT_VERSIONS='{"postgres":"15.8","gotrue":"2.170.0","postgrest":"12.2.3","storage":"1.20.0","realtime":"2.34.0","edgeRuntime":"1.67.0","gateway":"3.9.1","adapter":"1.0.0","fleetControl":"1.0.0","backupOperator":"1.0.0","agent":"1.0.0"}'
