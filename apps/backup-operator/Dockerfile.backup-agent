# Backup Agent for Fleet-managed Compose stacks. It runs on the stack's own
# PostgreSQL image, so pgBackRest and the PostgreSQL binaries match the ones the
# database uses for archive-push and restore.
ARG POSTGRES_IMAGE=deluxebear/postgres:17

FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w -X github.com/supabase/supabase/apps/backup-operator/internal/version.Version=${VERSION} -X github.com/supabase/supabase/apps/backup-operator/internal/version.Commit=${COMMIT}" -o /out/backup-operator ./cmd/backup-operator \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w -X github.com/supabase/supabase/apps/backup-operator/internal/version.Version=${VERSION} -X github.com/supabase/supabase/apps/backup-operator/internal/version.Commit=${COMMIT}" -o /out/fleet-docker-proxy ./cmd/fleet-docker-proxy \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w" -o /out/backup-fence ./cmd/compose-fence

FROM ${POSTGRES_IMAGE}
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="Supabase Backup Agent" \
      org.opencontainers.image.source="https://github.com/supabase/supabase/tree/master/apps/backup-operator" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"
COPY --from=build /out/backup-operator /usr/local/bin/backup-operator
# The stack's backup Docker proxy runs from this image too, so its policy
# always matches the Agent that uses it.
COPY --from=build /out/fleet-docker-proxy /usr/local/bin/fleet-docker-proxy
COPY --from=build /out/backup-fence /usr/local/bin/backup-fence
# The database image's pg_isready check does not apply to the Agent or proxy.
HEALTHCHECK NONE
USER postgres
ENTRYPOINT ["/usr/local/bin/backup-operator"]
CMD ["--mode=agent", "--agent-runtime=docker"]
