FLEET_CONTROL_VERSION=v0.1.0
FLEET_CONTROL_POSTGRES_PASSWORD=replace-with-a-random-secret
FLEET_CONTROL_SERVICE_ASSERTION_KEY=replace-with-at-least-32-random-bytes
FLEET_CONTROL_SERVICE_ASSERTION_ISSUER=studio-platform
FLEET_CONTROL_SERVICE_ASSERTION_AUDIENCE=fleet-control
FLEET_CONTROL_STORE_SYSTEM_IDENTIFIER=fleet-control
FLEET_CONTROL_STORE_DATA_DOMAIN=fleet-control-db
# Artifact bytes use a separate volume from Fleet Control metadata and the platform database.
FLEET_CONTROL_ARTIFACT_ROOT=/var/lib/fleet-artifacts
FLEET_CONTROL_ENROLLMENT_HTTPS_PORT=8091
FLEET_CONTROL_AGENT_GRPC_PORT=8092
FLEET_CONTROL_AGENT_TRUST_DOMAIN=fleet.internal
FLEET_CONTROL_HTTP_PORT=8090
