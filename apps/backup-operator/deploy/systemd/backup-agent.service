[Unit]
Description=Supabase Backup Host Agent
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=root
ExecStart=/usr/local/bin/backup-operator --mode=agent
EnvironmentFile=/etc/backup-operator/agent.env
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Mount /var/lib/backup-agent/drill-workspace as a dedicated filesystem before
# enabling restore drills; the Agent rejects a workspace on the PGDATA device.
ReadWritePaths=/var/lib/backup-agent /var/lib/backup-agent/drill-workspace /var/lib/postgresql /var/lib/pgbackrest /etc/pgbackrest

[Install]
WantedBy=multi-user.target
