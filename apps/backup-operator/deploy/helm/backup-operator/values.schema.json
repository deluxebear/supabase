{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "T3 keeps one Operator replica; HA rollout is a later production-hardening task."
    },
    "serviceAssertion": {
      "type": "object",
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "controlStore": {
      "type": "object",
      "required": ["existingSecret", "dsnKey", "systemIdentifier", "dataDomain"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "dsnKey": { "type": "string", "minLength": 1 },
        "systemIdentifier": { "type": "string", "minLength": 1 },
        "dataDomain": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": ["serviceAssertion", "controlStore"]
}
