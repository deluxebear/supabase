# Pin a released tag or digest-compatible tag. Production deployments should
# pin the image by digest in an override file.
BACKUP_OPERATOR_VERSION=v0.1.1

# Generate at least 32 random bytes and load the value from a protected secret
# manager. The empty value intentionally makes Compose fail closed.
BACKUP_OPERATOR_SERVICE_ASSERTION_KEY=
BACKUP_OPERATOR_POSTGRES_PASSWORD=

BACKUP_OPERATOR_HTTP_PORT=8080
BACKUP_OPERATOR_CONTROL_STORE_SYSTEM_IDENTIFIER=backup-operator-control
BACKUP_OPERATOR_CONTROL_STORE_DATA_DOMAIN=operator-db
BACKUP_OPERATOR_RUNTIME_ENABLED=true
